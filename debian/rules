#!/usr/bin/make -f

# Pass optimization or warning flags if needed
export DEB_CFLAGS_MAINT_APPEND = -O3

DEB_HOST_GNU_TYPE  ?= $(shell dpkg-architecture -qDEB_HOST_GNU_TYPE)
DEB_BUILD_GNU_TYPE ?= $(shell dpkg-architecture -qDEB_BUILD_GNU_TYPE)

%:
	dh $@

# Build libuv natively as a static archive before maxcso compiles
override_dh_auto_configure:
	dh_auto_configure
	@echo "=== Compiling Static libuv.a Archive ==="
	cd libuv && ./autogen.sh && ./configure \
		--host=$(DEB_HOST_GNU_TYPE) \
		--build=$(DEB_BUILD_GNU_TYPE) \
		--enable-static \
		--disable-shared
	make -C libuv -j$(shell nproc)
	# Copy the newly built library into a path maxcso's linker can see
	cp libuv/.libs/libuv.a .

# maxcso uses a plain Makefile, so we override the auto targets to use it directly
override_dh_auto_build:
	dh_auto_build -- PREFIX=/usr LIBS="-static-libgcc -static-libstdc++ -Wl,-Bstatic -L. -luv -ldeflate -llz4 -lz -Wl,-Bdynamic -lpthread"

override_dh_auto_install:
	dh_auto_install -- PREFIX=/usr

override_dh_auto_clean:
	dh_auto_clean
	rm -f libuv.a
	if [ -f libuv/Makefile ]; then make -C libuv clean; fi

# Statically linked binaries do not have shared library dependencies.
# Overriding this prevents errors when dpkg checks for dynamic .so mappings.
override_dh_shlibdeps:
	@echo "Bypassing dh_shlibdeps for static binary build tracking..."
